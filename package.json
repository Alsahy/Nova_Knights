{
  "name": "mars-base-adventure",
  "private": true,
  "version": "0.1.0",
  "description": "Mars Base Adventure: a Junior Astronaut Mission Trainer card game for kids aged 7-12 (NASA Space Apps 2026, Nova Knights).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "spec:extract": "tsx scripts/spec-extract.ts && tsx scripts/build-content.ts",
    "check:content": "tsx scripts/check-content.ts",
    "donki:fetch": "tsx scripts/fetch-donki.ts",
    "sim": "tsx scripts/simulate.ts",
    "donki:timeline": "tsx scripts/build-donki-timeline.ts"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
